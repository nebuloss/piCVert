# piCVert — copy to /etc/picvert.env and edit.
#
# Every setting is read WHEN IT IS USED, not when the service starts, so
# changing one and restarting is enough and there is never a stale value held
# from boot.

# --- where things are -----------------------------------------------------

# The CVs. The one directory the service writes to, and the only one worth
# backing up: everything else is rebuilt from the binary.
PICVERT_DATA=/var/lib/picvert/data

# The templates and the fonts. Only needed when running from a checkout rather
# than from an installed binary, which carries its own.
#PICVERT_HOME=/opt/picvert

# --- who can reach it -----------------------------------------------------

# The public port. Bound to localhost because a reverse proxy terminates TLS in
# front of it; set 0.0.0.0:3000 only if nothing is in front.
PICVERT_ADDR=127.0.0.1:3000

# The administration port. IT HAS NO ACCESS CONTROL AT ALL — its protection is
# that it is not proxied outwards. Never put this behind a public hostname, and
# never give it a password either: a password-protected surface would be the
# only thing here worth attacking.
#
# Leave it empty to run with no admin port at all, and create CVs with the
# command line instead.
PICVERT_ADMIN_ADDR=127.0.0.1:3001

# Which CVs are readable WITHOUT a link, at an address someone could type.
#
#   unset      nothing — every CV reached through its own private link
#   a,b        those two, by name
#   *          everything, including CVs somebody else made
#
# Unset is the default, and it is the right default: a CV carries a name, an
# email address and an employer.
#PICVERT_PUBLIC=

# A CV served at "/" instead of the front page. Naming one publishes it.
#PICVERT_HOME_PROFILE=

# --- how links are written ------------------------------------------------

# The address the world reaches this service at. Used to write the links the
# admin page hands out and the editor offers for sharing — behind a proxy the
# request's own host is the proxy's idea of it, and the scheme is plain HTTP
# whatever the world outside sees.
PICVERT_PUBLIC_URL=https://cv.example.com

# Say yes only when a proxy you control sets X-Forwarded-For. Trusting it
# unconditionally lets anyone claim a fresh address per request and makes the
# failure throttle purely decorative.
PICVERT_TRUST_PROXY=1

# --- safety nets ----------------------------------------------------------

# How long a deleted CV can still be recovered, in hours. What deletion removes
# exists nowhere else, so this is the only undo there is.
#PICVERT_TRASH_HOURS=24

# Failed links per address before that address is refused, and the window it is
# counted over, in minutes. This is what makes scanning for links expensive.
#PICVERT_RATE_MAX_FAILURES=10
#PICVERT_RATE_WINDOW_MIN=15

# HSTS. Deliberately WITHOUT includeSubDomains by default: served from an apex,
# it would force HTTPS on every subdomain for a year and browsers cache that.
#   off         send nothing (the proxy already does it)
#   subdomains  include them, knowingly
#PICVERT_HSTS=
#PICVERT_HSTS_MAX_AGE=31536000

# Who may show these pages in an iframe. 'self' compares the exact origin.
#PICVERT_FRAME_ANCESTORS='self'

# --- the journal ----------------------------------------------------------

# How long a field stays "being edited", in minutes, and how many entries a CV
# keeps. One entry per editing episode, not per save.
#PICVERT_EPISODE_MIN=5
#PICVERT_HISTORY_ENTRIES=500

# Commit every save, when the data directory is a git checkout.
#PICVERT_GIT=1

# --- appearance -----------------------------------------------------------

# The template a CV gets when it names none.
#PICVERT_TEMPLATE=material-you
