# piCVert — copy to /etc/picvert.yaml and edit.
#
# Every setting below is optional and shows its default, so an empty file is a
# working service. This file is NEVER rewritten by piCVert: your comments
# survive, and it is safe to keep in git — provided you do not put secrets in
# the copy you commit.
#
# The environment overrides anything here, which is how a container injects a
# secret without ever writing it to a disk.
#
#   picvert config     shows what the service would actually be told
#   picvert passwd     sets the administration password (stored with the CVs)
#
# JSON works too, in this same file: YAML is a superset of it, so
# {"listen": "0.0.0.0:3000"} parses exactly as the equivalent below. Use it if
# the file is generated rather than written — Ansible, Nix, a shell script. It
# is not the default because a generated file has nobody to explain itself to,
# and the comments here are three quarters of the point.

# The address the world reaches this service at, WITH its scheme.
#
# This is what every link piCVert hands out is built from: the private links in
# the admin page, the share link in the editor, the address `picvert new`
# prints. Without it those come out as bare paths, which are no use to somebody
# who has to paste one into a message.
#
# It cannot be worked out from a request: behind a reverse proxy the Host header
# is the proxy's idea of the service, and the scheme is plain HTTP whatever the
# world outside sees.
domain: "https://cv.example.com"

# The public port, on every interface.
#
# Which is what a container needs: inside one, "localhost" means inside the
# container and a port forward reaches nothing. Narrow it to 127.0.0.1 if a
# reverse proxy runs on this same machine and nothing else should reach the
# service directly.
listen: "0.0.0.0:3000"

admin:
  # The administration port, also on every interface — an administration page
  # that can only be reached from the machine it runs on is one nobody reaches,
  # because that machine is a container.
  #
  # It manages every CV and shows every private link on the service, so being
  # reachable makes the password below mandatory rather than optional.
  #
  # Reach it over SSH:  ssh -L 3001:127.0.0.1:3001 your-host
  listen: "0.0.0.0:3001"

  # A PASSWORD HASH, never a password.
  #
  # You usually do not set this at all: `picvert passwd` stores the password
  # with the CVs, where it needs no copying and this file stays untouched.
  #
  # Set it here only when this file is generated for you — by Ansible, by a Nix
  # module, by anything templating a hash in. What is written here WINS over
  # what `picvert passwd` stored, so a hash under version control is never
  # quietly replaced by one generated on the machine.
  #
  # Required, because the port above is reachable from the network: piCVert
  # refuses to start otherwise. What used to protect this port was that nobody
  # could reach it, and binding it wider removes exactly that.
  #
  # deploy/install.sh generates one at install time and prints it once.
  password: ""

  # To keep it off the network entirely instead:
  #
  #   listen: "127.0.0.1:3001"     and reach it over an SSH tunnel
  #   listen: ""                   and use `picvert new` from a shell
  #
  # "It is only on our internal network" is not on its own a reason to skip the
  # password. A LAN has other machines on it — a laptop, a phone, a printer,
  # another container — and the private links this page displays are the only
  # credentials this service has.

  # A PASSWORD HASH, never a password. Run `picvert passwd` and paste what it
  # prints. piCVert refuses to start if this looks like plaintext.
  #
  # Empty means no login, which is the default and is right for the normal
  # arrangement: the port is protected by not being reachable from outside.
  # Set this if you intend to reach it over a VPN or a tunnel — it is defence
  # in depth, NOT permission to proxy this port to the internet.
  # password: "pbkdf2-sha256$600000$...$..."

  # How long a login lasts. The signing key is made at startup and never
  # written down, so a restart signs everybody out.
  session: "12h"

  # The shortest password `picvert passwd` will hash. 0 turns the check off.
  #
  # A length floor and nothing more: there is no character-class rule here, no
  # expiry and no history, and there will not be — those are what make people
  # write a password down and then change one character of it a month.
  #
  # Lower it, or set it to 0, when this machine's risk is yours to judge: an
  # appliance on a private network, a demonstration, a test. The floor is our
  # guess about your deployment, and refusing you achieves nothing anyway — a
  # hash is a hash, and one can be produced another way in a minute.
  #
  # At 0 the command says so every time it runs, because a machine whose floor
  # is off is a thing to be reminded of rather than to have decided once.
  min-password-length: 10

# Cloudflare Turnstile, for the front page where a stranger can make a CV.
#
# Off unless BOTH keys are set. Without it there is no public creation form at
# all: a route that lets anybody make a CV is a disk somebody fills with a shell
# loop, and a per-address limit only slows down an attacker with one address.
#
# The site key is public and goes into the page. The secret is not, and is what
# makes the challenge real — one checked only in the browser is not checked.
turnstile:
  # site-key: "0x4AAAAAAA..."
  # secret: "0x4AAAAAAA..."

access:
  # Which CVs are readable at a guessable address. Empty means none, and that
  # is the right default: a CV carries a name, an email address and an employer.
  # Use ["*"] to publish everything, including CVs somebody else made.
  public: []

  # Honour X-Forwarded-For. Say yes only behind a proxy you control: trusting it
  # unconditionally lets anyone claim a fresh address per request and makes the
  # failure throttle decorative.
  trust-proxy: false

# A CV served at "/" instead of the front page. Naming one publishes it.
# home-profile: "jean"

limits:
  # What one CV may occupy in total: documents, portraits, journals. A CV with a
  # photo and two languages uses well under a megabyte. This is the ceiling that
  # stops one filling a disk — asking for four hundred languages otherwise does
  # it in a few seconds.
  max-profile-mb: 8

  # How much room must remain free after any write. Not zero: a disk with
  # nothing left is one where the next write of any kind fails, including the
  # log that would say so.
  min-free-mb: 64

  max-photo-mb: 4

  # Journal entries kept per CV. One entry is an episode of editing, not a
  # keystroke: a minute of typing adds two, not forty.
  history-entries: 500

  # How long a deleted CV can still be recovered. Deletion is one click and what
  # it destroys exists nowhere else.
  trash-hours: 24

editing:
  # One person edits a CV at a time. These are the two ways a lease is lost.
  #
  # lease-ttl: the window stopped talking — closed, crashed, disconnected.
  # inactivity: the window is still there and nothing has changed, which is a
  #   tab left open on a second monitor. It heartbeats perfectly and would
  #   otherwise hold the CV for ever.
  lease-ttl: "45s"
  inactivity: "15m"

  # How long a field stays "being edited" in the journal.
  episode-minutes: 5

security:
  # Bad links from one address before it is refused, and the window they are
  # counted over. A VALID link is always served and clears the counter, so one
  # person guessing cannot lock out everybody behind a shared address.
  rate-max-failures: 10
  rate-window-minutes: 15

  # "", "off", or "subdomains". Deliberately without subdomains by default:
  # served from an apex it would force HTTPS on every neighbour for a year, and
  # browsers cache that.
  hsts: ""

  # Who may show these pages in an iframe.
  frame-ancestors: "'self'"

# Where the CVs live. The one directory worth backing up.
#
# NOT commented out, and that matters: `picvert new` and `picvert backup` read
# this file and nothing else, so leaving it to a default put a CV made from the
# command line somewhere the service does not read and the backups do not
# cover. It looked like it had worked.
data-dir: "/var/lib/picvert/data"

# Only needed when running from a checkout. An installed binary carries the
# templates, the fonts and the whole interface.
# home: "/opt/picvert"
# template: "material-you"
