#!/bin/sh
# piCVert's nightly backup, for a host running OpenRC rather than systemd.
#
# Install to /etc/periodic/daily/picvert-backup and make it executable. Alpine
# runs everything in that directory once a day through busybox crond, which is
# the OpenRC equivalent of the systemd timer beside this file.
#
# --keep is what makes it unattended: without it a nightly backup is a disk
# filling up on a schedule, which takes the service down with it and is a worse
# failure than having no backup at all.
#
# # THREE THINGS THAT EACH LOOK LIKE NOTHING
#
# The date is worked out HERE, before `su`, not inside the quoted command it
# runs. Nested quoting put a literal `$(date +%Y-%m-%d)` in the filename, and
# the backup succeeded — which is the worst way for this to go wrong, because
# every night would overwrite one file with that name and rotation would keep
# fourteen copies of nothing.
#
# The working directory is set, because `su` keeps the one it was called from —
# root's, for a cron job — and the command resolves a relative path as its first
# act. That fails with "stat .: permission denied", which names nothing.
#
# And the output is named rather than reached by changing directory to it: the
# command reads its configuration for where the CVs are, so changing directory
# first made it look for them inside the backups folder.
set -eu

DATA=/var/lib/picvert
OUT="$DATA/backups/picvert-$(date +%Y-%m-%d).tar.gz"

exec su picvert -s /bin/sh -c "cd '$DATA' && exec /opt/picvert/picvert backup --out '$OUT' --keep 14"
