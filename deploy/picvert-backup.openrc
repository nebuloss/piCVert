#!/bin/sh
# piCVert's nightly backup, for a host running OpenRC rather than systemd.
#
# Install to /etc/periodic/daily/picvert-backup and make it executable. Alpine
# runs everything in that directory once a day through busybox crond, which is
# the OpenRC equivalent of the systemd timer beside this file.
#
# --keep is what makes it unattended: without it a nightly backup is a disk
# filling up on a schedule, which takes the service down with it and is a worse
# failure than having no backup at all.
#
# # TWO THINGS THAT BOTH LOOK LIKE NOTHING
#
# The output is NAMED rather than reached by changing directory first. Changing
# directory meant the command looked for the CVs relative to where it was
# writing, and reported "no data directory" at a path inside the backups folder.
#
# And it starts in a directory the service account can read. `su` leaves the
# working directory where it was — root's, usually — and the first thing the
# command does is resolve a relative path, which fails with "stat .: permission
# denied" and names nothing that would lead anybody to this line.
set -eu

DATA=/var/lib/picvert
exec su picvert -s /bin/sh -c \
  "cd '$DATA' && exec /opt/picvert/picvert backup \
     --out '$DATA/backups/picvert-\$(date +%Y-%m-%d).tar.gz' --keep 14"
